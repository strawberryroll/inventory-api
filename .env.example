# docker compose가 읽는 환경변수 견본입니다.
# 이 파일을 .env 로 복사한 뒤 값을 채워 쓰세요.   cp .env.example .env
# .env 는 .gitignore 에 들어 있어서 Git에 올라가지 않습니다. (실제 비밀번호를 이 견본 파일에 적지 마세요)

# MySQL 비밀번호 (필수). 앱과 MySQL 컨테이너가 같은 값을 사용합니다.
DB_PASSWORD=여기에_사용할_비밀번호

# 앱을 열 내 컴퓨터의 포트 (선택, 기본 8080). 이미 8080을 쓰고 있다면 8081 등으로 바꾸세요.
# APP_PORT=8080
